{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift: Build Debug",
      "type": "shell",
      "command": "swift build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$swift-compile"
    },
    {
      "label": "swift: Run Tests",
      "type": "shell",
      "command": "swift test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$swift-compile"
    }
  ]
}
